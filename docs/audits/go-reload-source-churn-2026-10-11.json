  "reproduction_script": "import json,sys,tempfile,time,hashlib\nfrom pathlib import Path\nrepo=Path('/Users/yanjixiong/github/mini-loop')\nsys.path.insert(0,str(repo/'python'));sys.path.insert(0,str(repo/'python/tools'))\nimport watchfiles,uvicorn\nfrom watchfiles.main import RustNotify\nfrom watchfiles_contracts import _native_case\nassert watchfiles.__version__=='1.2.0' and uvicorn.__version__=='0.49.0'\nchurn=int(sys.argv[1]);fixture_path=repo/'go/testdata/python-watchfiles.json';cases=json.loads(fixture_path.read_text())['native_events']\nresult={'churn':churn,'watchfiles_version':watchfiles.__version__,'uvicorn_version':uvicorn.__version__,'fixture_sha256':hashlib.sha256(fixture_path.read_bytes()).hexdigest(),'subscriptions':[],'cases':[]}\nwith tempfile.TemporaryDirectory(prefix='mini-loop-source-churn-') as scratch:\n root=Path(scratch).resolve();warm=root/'warm';warm.mkdir()\n for index in range(churn):\n  start=time.monotonic();observer=RustNotify([str(warm)],False,False,300,True,True)\n  representation=repr(observer);assert 'FsEventWatcher' in representation and 'latency: 0.0' in representation and 'flags: 18' in representation\n  observer.close();closed=False\n  try:observer.watch(1,1,1,None)\n  except RuntimeError:closed=True\n  assert closed\n  result['subscriptions'].append({'index':index,'seconds':time.monotonic()-start,'closed':closed})\n for case in cases:\n  recipe={k:v for k,v in case.items() if k not in ('changed','closed','native_arguments')}\n  start=time.monotonic()\n  try:\n   observed=_native_case(root/case['name'],recipe)\n   sample={'name':case['name'],'changed':observed['changed'],'expected':case['changed'],'matches_fixture':observed['changed']==case['changed'],'closed':observed['closed'],'native_arguments':observed['native_arguments'],'seconds':time.monotonic()-start}\n  except Exception as error:\n   sample={'name':case['name'],'error_class':type(error).__name__,'error':str(error),'seconds':time.monotonic()-start,'matches_fixture':False}\n  result['cases'].append(sample);print(json.dumps(sample),flush=True)\noutput=Path(f'/tmp/mini-loop-source-churn-{churn}-2026-10-11.json');output.write_text(json.dumps(result,indent=2)+'\\n')\nprint('COMPLETE',churn,sum(c['matches_fixture'] for c in result['cases']),len(cases),flush=True)\n",
