# Copy to .env.task (ignored). Paths refer to existing deployment-host files.
# No secret contents belong in this file, the image or the build context.
MINILOOP_TASK_IMAGE=registry.example/mini-loop-task@sha256:REPLACE_WITH_BUILT_DIGEST
TASK_TEMPORAL_ADDRESS=temporal.example.internal:7233
TASK_TEMPORAL_SERVER_NAME=temporal.example.internal
TASK_NAMESPACE=default
TASK_QUEUE=mini-loop-task-v1
TASK_TOKENS_FILE=/absolute/private/path/task-tokens.json
TASK_CURSOR_FILE=/absolute/private/path/task-cursor
TASK_OPENAI_KEY_FILE=/absolute/private/path/openai-key
TASK_TEMPORAL_CA_FILE=/absolute/private/path/temporal-ca.pem
TASK_TEMPORAL_API_CERT_FILE=/absolute/private/path/temporal-api.pem
TASK_TEMPORAL_API_KEY_FILE=/absolute/private/path/temporal-api.key
TASK_TEMPORAL_WORKER_CERT_FILE=/absolute/private/path/temporal-worker.pem
TASK_TEMPORAL_WORKER_KEY_FILE=/absolute/private/path/temporal-worker.key
TASK_API_MAX_INFLIGHT=32
TASK_ACTIVITY_SLOTS=1
TASK_WORKFLOW_SLOTS=2
TASK_MODEL=openai:gpt-4.1-mini
TASK_MAX_TOKENS=4096
TASK_MODEL_TIMEOUT_SECONDS=60
# This is a client-mTLS deployment example. API-key-only Temporal deployments
# must supply an explicit override using MINILOOP_TASK_TEMPORAL_API_KEY_FILE,
# omit the client-certificate pair, and retain verified TLS=true.
# API replicas need an existing ingress on the Compose network; no host port
# or ingress/Temporal/SQL/Redis image is provisioned by this profile.
