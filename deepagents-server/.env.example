# Generate each bearer token with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Replace this example before serving; token keys are secrets, values are owner IDs.
MINILOOP_DEEPAGENTS_TOKENS={"replace-with-a-random-token-at-least-32-characters":"alice"}
MINILOOP_DEEPAGENTS_MODEL=openai:gpt-4.1-mini
MINILOOP_DEEPAGENTS_MAX_TOKENS=4096
# Timeout for one model request; this is not the total background Run timeout.
MINILOOP_DEEPAGENTS_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
LANGSMITH_TRACING=false
# Only required for the licensed standard Agent Server Docker deployment:
LANGSMITH_API_KEY=
LANGGRAPH_CLOUD_LICENSE_KEY=
# Generate URL-safe password with secrets.token_urlsafe(32); used directly in a URI:
POSTGRES_PASSWORD=
# Build the Dockerfile once. Select the resulting local sha256:<image-id> or a
# registry repository@sha256:<digest>; API and workers must use that exact build.
MINILOOP_DEEPAGENTS_IMAGE=
# Production queue settings. Different Threads run concurrently; one Thread queues.
N_JOBS_PER_WORKER=2
# Wall timeout for each background execution attempt (24 hours), independent of HTTP.
BG_JOB_TIMEOUT_SECS=86400
# Pinned langgraph-api 0.16.0 permits this many TOTAL attempts, including the first.
# Retries apply to infrastructure/shutdown failures; application errors are terminal.
BG_JOB_MAX_RETRIES=3
# Isolated worker threads each get this pool limit divided by N_JOBS_PER_WORKER.
# Re-size together with concurrency and replica count against the PostgreSQL budget.
LANGGRAPH_POSTGRES_POOL_MAX_SIZE=32
# Compose fixes runtime shutdown grace at 180s and Docker stop grace at 210s.
# Preserve PostgreSQL's named volume across restart/redeploy; do not use down -v.
