{"openapi":"3.1.0","info":{"title":"mini-loop","version":"0.1.0"},"paths":{"/healthz":{"get":{"summary":"Healthz","operationId":"healthz_healthz_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/sessions":{"post":{"summary":"Create Session","operationId":"create_session_sessions_post","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateSessionReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"summary":"List Sessions","operationId":"list_sessions_sessions_get","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":100,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/mode":{"post":{"summary":"Set Mode","description":"Change the session's risk->decision posture (see permissions.py).\n\nThrough this edge the change is told to the model at its next round\n(session.change_permission_mode queues the note); raw attribute\nwrites remain the silent, process-local path.","operationId":"set_mode_sessions__session_id__mode_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ModeReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/personal-skills/preview":{"post":{"summary":"Preview Personal Skill","description":"Create a reviewable, expiring draft without writing a skill.","operationId":"preview_personal_skill_sessions__session_id__personal_skills_preview_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PersonalSkillPreviewReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/personal-skills/{draft_id}/commit":{"post":{"summary":"Commit Personal Skill","description":"Publish exactly the authenticated caller's reviewed pending draft.","operationId":"commit_personal_skill_sessions__session_id__personal_skills__draft_id__commit_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"draft_id","in":"path","required":true,"schema":{"type":"string","title":"Draft Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PersonalSkillCommitReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}":{"get":{"summary":"Get Session","operationId":"get_session_sessions__session_id__get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Delete Session","operationId":"delete_session_sessions__session_id__delete","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/steer":{"post":{"summary":"Steer Session","description":"Deliver input to a session whatever it is doing. Never 409s.\n\nBusy: the text reaches the running turn at its next loop round as a\n`<user_interjection>` -- OpenWorker's busy-session steering, on our\ninjector seam. Idle: the text starts an ordinary turn now, in the\nbackground. Both references agree on the idle half (OpenWorker: an\nidle session starts a fresh turn; dsh: steer carries wakeup), and\nparking used to be the behavior here -- durable after round 192, so\na steer to an idle session could wait forever while the caller\nbelieved the words were on their way. The caller who wants\npark-until-next-turn semantics still has them through any\nprocess-local `session.steer()` call; over HTTP, steering means\n\"make sure the agent hears this\", and an idle agent hears it by\nrunning.","operationId":"steer_session_sessions__session_id__steer_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MessageReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/fork":{"post":{"summary":"Fork Session","description":"Branch a new session from an idle session's transcript.\n\nOwner-scoped like every session route; the child belongs to the same\nowner. A busy source is 409 -- its tail is an open turn, not a\ncompleted boundary (dsh's fork eligibility rule).","operationId":"fork_session_sessions__session_id__fork_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/cancel":{"post":{"summary":"Cancel Run","description":"Stop the turn in flight, if there is one.","operationId":"cancel_run_sessions__session_id__cancel_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/workflows":{"get":{"summary":"List Workflows","description":"This session's workflow runs, or an honest disabled flag.\n\n`enabled` is explicit so the UI can say \"not enabled on this\ndeployment\" instead of rendering a vacuously empty list.","operationId":"list_workflows_sessions__session_id__workflows_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"summary":"Launch Workflow","description":"The human's own launch edge.\n\nUnlike /messages -- untrusted on purpose, because message TEXT flows\nthrough the model and any capability would ride every action of the\nturn -- this payload IS the single action the human is invoking:\ndefinition plus args, no model interpretation in between. That is\nexactly what explicit_human authority with a single approved\ncapability was built to express, and it follows the cron precedent\n(scheduling over authenticated HTTP is the human edge). The stamp is\nonly issued on an AUTHENTICATED deployment: an anonymous bind cannot\nclaim to be the human, so an open deployment refuses launch and the\nterminal path (which stamps its own trusted-local context) remains\nthe only edge there.","operationId":"launch_workflow_sessions__session_id__workflows_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowLaunchReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/workflows/{run_id}":{"get":{"summary":"Workflow Detail","operationId":"workflow_detail_sessions__session_id__workflows__run_id__get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"run_id","in":"path","required":true,"schema":{"type":"string","title":"Run Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/workflows/{run_id}/cancel":{"post":{"summary":"Cancel Workflow","description":"The human's cancel edge: capability-reducing, so plain ownership\nsuffices -- no authority stamp needed to STOP work.","operationId":"cancel_workflow_sessions__session_id__workflows__run_id__cancel_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"run_id","in":"path","required":true,"schema":{"type":"string","title":"Run Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowCancelReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/cron":{"get":{"summary":"List Cron","description":"This session's scheduled jobs, structured, with their arm state.","operationId":"list_cron_sessions__session_id__cron_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"summary":"Schedule Cron","description":"Schedule a job for this session. Scheduling over authenticated\nHTTP is the human authorization edge, so the job is armed exactly\nlike one scheduled from inside the process.","operationId":"schedule_cron_sessions__session_id__cron_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CronReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/cron/{job_id}":{"delete":{"summary":"Cancel Cron","operationId":"cancel_cron_sessions__session_id__cron__job_id__delete","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"job_id","in":"path","required":true,"schema":{"type":"string","title":"Job Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/self-audit":{"get":{"summary":"Self Audit Report","description":"The runtime's self-observation report (self_audit.py).\n\nOwner-scoped under authentication: the caller sees their own\nsessions' activity, ledgers, trajectories and skill usage. The\nmanager-wide subsystem ledgers are included only when auth is not\nconfigured -- on an open single-user deployment the caller IS the\noperator; on an authenticated one, cross-tenant operational\nmetadata stays out of tenant responses.","operationId":"self_audit_report_self_audit_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/sessions/{session_id}/skills":{"get":{"summary":"Session Skills","description":"The layered skill catalogue exactly as this session's model sees it.","operationId":"session_skills_sessions__session_id__skills_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/memory":{"get":{"summary":"Session Memory","description":"This session owner's memories: names and descriptions, not bodies.","operationId":"session_memory_sessions__session_id__memory_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/tasks":{"get":{"summary":"Session Tasks","description":"The session workspace's task board, structured.\n\nRead through a fresh TaskStore over the same directory: the board is\nfile-backed by design (teammates share it through the filesystem),\nso a read-only view needs no live store and mutates nothing.","operationId":"session_tasks_sessions__session_id__tasks_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/goal":{"get":{"summary":"Session Goal","description":"The session's durable objective and soft-mode flags.","operationId":"session_goal_sessions__session_id__goal_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/team":{"get":{"summary":"Session Team","description":"This session's team identity and a non-consuming inbox view.\n\nServed through MessageBus.peek: read()'s drain is the delivery\ncontract, so a viewer that used it would deliver the agent's\nmessages to nobody (round 250 blocked the pane on exactly that).","operationId":"session_team_sessions__session_id__team_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/memory/{name}":{"get":{"summary":"Session Memory Body","description":"One memory's stored body, for its owner.\n\nSafe to serve because the store masks at the write (memories are the\nmost durable disk sink here and the census classifies them RECORDED),\nand because this body is already fed back into the owner's own\nrequests by runtime_facts -- the reader is seeing what their model\nsees, not a new disclosure.","operationId":"session_memory_body_sessions__session_id__memory__name__get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"name","in":"path","required":true,"schema":{"type":"string","title":"Name"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/benchmark":{"post":{"summary":"Run Benchmark","description":"Run the paired benchmark on the fake transport, in process.\n\nDeliberately fake-only: this exists so the UI can exercise and\ndisplay the instrument. A real-endpoint run spends the operator's\nmodel budget and stays a terminal act (tools/paired_benchmark.py) --\na button that spends money is not a button this server grows.","operationId":"run_benchmark_benchmark_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/sessions/{session_id}/propose-improvement":{"post":{"summary":"Propose Improvement Route","description":"Run the verified improvement loop in this session's workspace.\n\nEverything self_improve.py refuses (non-git workspace, empty\nacceptance command) comes back 400; a busy session is 409 like a\nmessage would be. The proposal lands on the isolated branch --\nmerging stays a human act outside this API.","operationId":"propose_improvement_route_sessions__session_id__propose_improvement_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImprovementReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/improvements":{"get":{"summary":"List Improvements","description":"The proposal lineage (improvement_archive.py), newest first.\n\nSame scoping rule as /self-audit: authenticated callers read their\nown lineage; an open single-user deployment reads all of it.","operationId":"list_improvements_improvements_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/self-audit/suggestions":{"get":{"summary":"Improvement Suggestions","description":"Candidate objectives derived from the problem ledgers.\n\nSuggestion is not authorization: nothing launches from here; the\nhuman reviews, edits, and submits through propose-improvement.","operationId":"improvement_suggestions_self_audit_suggestions_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/self-audit/bench-task-drafts":{"get":{"summary":"Bench Task Drafts","description":"Candidate benchmark tasks hatched from the problem ledgers.\n\nDrafts, not admissions: each row ships without an expect predicate\nand nothing here touches the task sets -- a human authors the\njudgment and admits the task by editing benchmark.py.","operationId":"bench_task_drafts_self_audit_bench_task_drafts_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/sessions/{session_id}/cron/{job_id}/arm":{"post":{"summary":"Arm Cron","description":"Re-authorize a cron job restored from disk.\n\nActivation is process-local and never persisted: a durable job\nsurvives a restart as a *fact*, but firing unattended again needs a\nnew authorization edge, which this operator call records. Scoped to\nthe caller's own session, like cancel. Deliberately not a model tool.","operationId":"arm_cron_sessions__session_id__cron__job_id__arm_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"job_id","in":"path","required":true,"schema":{"type":"string","title":"Job Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/transcript":{"get":{"summary":"Read Transcript","description":"One epoch of the durable transcript -- the current one by default.\n\nSuperseded epochs are the canonical record of what the agent actually\nsaw before a compaction rewrote its history (storage.py); this is the\noperator's way to read them. Persisted rows are already masked.","operationId":"read_transcript_sessions__session_id__transcript_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"epoch","in":"query","required":false,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Epoch"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/approvals":{"get":{"summary":"List Approvals","description":"Tool calls parked waiting for a human answer (see approvals.py).","operationId":"list_approvals_sessions__session_id__approvals_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/approvals/{approval_id}":{"post":{"summary":"Resolve Approval","operationId":"resolve_approval_sessions__session_id__approvals__approval_id__post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"approval_id","in":"path","required":true,"schema":{"type":"string","title":"Approval Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApprovalReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/messages":{"post":{"summary":"Post Message","operationId":"post_message_sessions__session_id__messages_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MessageReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/messages/stream":{"post":{"summary":"Post Message Stream","operationId":"post_message_stream_sessions__session_id__messages_stream_post","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MessageReq"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/events":{"get":{"summary":"Observe","operationId":"observe_sessions__session_id__events_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"envelope","in":"query","required":false,"schema":{"type":"boolean","default":false,"title":"Envelope"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/sessions/{session_id}/trajectories":{"get":{"summary":"List Session Trajectories","operationId":"list_session_trajectories_sessions__session_id__trajectories_get","parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":100,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/trajectories":{"get":{"summary":"List Trajectories","operationId":"list_trajectories_trajectories_get","parameters":[{"name":"session_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Session Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":100,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/trajectories/{trajectory_id}/export":{"get":{"summary":"Export Trajectory","operationId":"export_trajectory_trajectories__trajectory_id__export_get","parameters":[{"name":"trajectory_id","in":"path","required":true,"schema":{"type":"string","title":"Trajectory Id"}},{"name":"format","in":"query","required":false,"schema":{"type":"string","default":"json","title":"Format"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/trajectories/{trajectory_id}/view":{"get":{"summary":"View Trajectory","description":"The dsh-style ledger for one recorded run, as one HTML page.\n\nSame access order as the JSON route below: ownership from the header\nbefore any bulk read, then the size bound -- rendering is a whole-file\nmaterialisation, so it inherits the JSON route's ceiling rather than\ninventing a second one.","operationId":"view_trajectory_trajectories__trajectory_id__view_get","parameters":[{"name":"trajectory_id","in":"path","required":true,"schema":{"type":"string","title":"Trajectory Id"}}],"responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/trajectories/{trajectory_id}":{"get":{"summary":"Get Trajectory","operationId":"get_trajectory_trajectories__trajectory_id__get","parameters":[{"name":"trajectory_id","in":"path","required":true,"schema":{"type":"string","title":"Trajectory Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/":{"get":{"summary":"Console","operationId":"console__get","responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}}}}},"/ui":{"get":{"summary":"Web Ui","description":"The full web UI (docs/WEBUI_PLAN.md): separate sources under\nmini_loop/webui/, assembled into one self-contained inline page so\nthe CSP and the no-static-mount posture stay exactly as they are.","operationId":"web_ui_ui_get","responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}}}}}},"components":{"schemas":{"ApprovalReq":{"properties":{"decision":{"type":"string","enum":["allow","deny"],"title":"Decision"},"answer":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Answer"},"remember":{"type":"boolean","title":"Remember","default":false}},"type":"object","required":["decision"],"title":"ApprovalReq"},"CreateSessionReq":{"properties":{"system":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"System"},"model":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Model"},"mode":{"anyOf":[{"type":"string","enum":["readonly","interactive","auto"]},{"type":"null"}],"title":"Mode"},"workspace":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Workspace"}},"type":"object","title":"CreateSessionReq"},"CronReq":{"properties":{"cron":{"type":"string","maxLength":100,"minLength":1,"title":"Cron"},"prompt":{"type":"string","minLength":1,"title":"Prompt"},"recurring":{"type":"boolean","title":"Recurring","default":true},"durable":{"type":"boolean","title":"Durable","default":true}},"type":"object","required":["cron","prompt"],"title":"CronReq"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ImprovementReq":{"properties":{"objective":{"type":"string","maxLength":4000,"minLength":1,"title":"Objective"},"acceptance_command":{"type":"string","maxLength":1000,"minLength":1,"title":"Acceptance Command"},"max_rounds":{"type":"integer","maximum":10.0,"minimum":1.0,"title":"Max Rounds","default":3},"parent_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Parent Id"}},"type":"object","required":["objective","acceptance_command"],"title":"ImprovementReq"},"MessageReq":{"properties":{"message":{"type":"string","title":"Message"}},"type":"object","required":["message"],"title":"MessageReq"},"ModeReq":{"properties":{"mode":{"type":"string","enum":["readonly","interactive","auto"],"title":"Mode"}},"type":"object","required":["mode"],"title":"ModeReq"},"PersonalSkillCommitReq":{"properties":{"digest":{"type":"string","maxLength":64,"minLength":64,"pattern":"^[0-9a-f]{64}$","title":"Digest"}},"additionalProperties":false,"type":"object","required":["digest"],"title":"PersonalSkillCommitReq"},"PersonalSkillPreviewReq":{"properties":{"name":{"type":"string","maxLength":64,"minLength":1,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","title":"Name"},"focus":{"type":"string","maxLength":2000,"title":"Focus","default":""}},"additionalProperties":false,"type":"object","required":["name"],"title":"PersonalSkillPreviewReq"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"},"WorkflowCancelReq":{"properties":{"reason":{"type":"string","title":"Reason","default":"requested by operator"}},"type":"object","title":"WorkflowCancelReq"},"WorkflowLaunchReq":{"properties":{"definition":{"additionalProperties":true,"type":"object","title":"Definition"},"args":{"additionalProperties":true,"type":"object","title":"Args","default":{}},"action_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Action Id"}},"type":"object","required":["definition"],"title":"WorkflowLaunchReq"}}}}